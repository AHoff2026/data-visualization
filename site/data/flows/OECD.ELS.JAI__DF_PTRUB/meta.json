{"slug":"OECD.ELS.JAI__DF_PTRUB","id":"DSD_TAXBEN_PTR@DF_PTRUB","name":"What taking a job costs you","agency":"OECD.ELS.JAI","version":"1.0","description":"This indicator measures the financial disincentives to participate in the labour market. It calculates the proportion of earnings in the new job that are lost to either higher taxes or lower benefit entitlements when a jobless person takes up employment and claims unemployment benefits. Higher values means higher financial disincentives.\n<p />Calculations for families with children assume 2 children aged 4 and 6 who do not use formal childcare.","topic":"ECON","source_url":"https://data-explorer.oecd.org/vis?df[id]=DSD_TAXBEN_PTR@DF_PTRUB&df[ag]=OECD.ELS.JAI&df[vs]=1.0","dims":[{"id":"REF_AREA","name":"Country","ids":["AUS","AUT","BEL","BGR","CAN","CHE","CHL","CYP","CZE","DEU","DNK","ESP","EST","FIN","FRA","GBR","GRC","HRV","HUN","IRL","ISL","ISR","ITA","JPN","KOR","LTU","LUX","LVA","MLT","NLD","NOR","NZL","OECD","POL","PRT","ROU","RUS","SVK","SVN","SWE","TUR","USA"],"names":["Australia","Austria","Belgium","Bulgaria","Canada","Switzerland","Chile","Cyprus","Czechia","Germany","Denmark","Spain","Estonia","Finland","France","United Kingdom","Greece","Croatia","Hungary","Ireland","Iceland","Israel","Italy","Japan","Korea","Lithuania","Luxembourg","Latvia","Malta","Netherlands","Norway","New Zealand","OECD","Poland","Portugal","Romania","Russia","Slovak Republic","Slovenia","Sweden","T\u00fcrkiye","United States"]},{"id":"MEASURE","name":"Indicator","ids":["TLBDSNJ"],"names":["Changes in tax and benefit amounts when starting a new job"]},{"id":"UNIT_MEASURE","name":"Measured as","ids":["PT_EARN_NEW_JOB"],"names":["Percentage of earnings in the new job"]},{"id":"INCOME_CURR","name":"Wage level","ids":["AW100","AW67","MINW"],"names":["100% of average wage","67% of average wage","Minimum wage"],"default":1},{"id":"HOUSEHOLD_TYPE","name":"HOUSEHOLD_TYPE","ids":["C_C0","C_C2","S_C0","S_C2"],"names":["Couple, no children","Couple, 2 children","Single person, no children","Single person, 2 children"],"default":2},{"id":"AGE_CHILDREN","name":"AGE_CHILDREN","ids":["Y4_6","Y2_3"],"names":["4 and 6 years","2 and 3 years"]},{"id":"INCOME_PART","name":"INCOME_PART","ids":["AW100","AW67","MINW","NOEARN_UNEMP_WO_CONBEN","_Z"],"names":["100% of average wage","67% of average wage","Minimum wage","No earnings, unemployed without contributory benefits","Not applicable"],"default":4},{"id":"CHILDCARE_USE","name":"CHILDCARE_USE","ids":["NO","YES"],"names":["No","Yes"]},{"id":"UNEMP_DURATION","name":"UNEMP_DURATION","ids":["M12","M18","M2","M24","M36","M4","M6","M60","M8","_Z"],"names":["12 months","18 months","2 months","24 months","36 months","4 months","6 months","60 months","8 months","Not applicable"],"default":2},{"id":"SOC_ASS_BENEFIT","name":"SOC_ASS_BENEFIT","ids":["NO","YES","_Z"],"names":["No","Yes","Not applicable"]},{"id":"HOUSE_BENEFIT","name":"Housing benefit","ids":["NO","YES"],"names":["No","Yes"]},{"id":"TEMP_INTOWORK_BENEFIT","name":"In-work benefit","ids":["NO","YES"],"names":["No","Yes"]},{"id":"BENEFIT_TYPE","name":"BENEFIT_TYPE","ids":["UNEMP","GMI"],"names":["Unemployment benefit","Guaranteed minimum income"],"default":0},{"id":"CONTRIBUTION","name":"CONTRIBUTION","ids":["_Z","CB","CF","TAX","_O","_T"],"names":["Not applicable","Contribution of childcare benefits","Contribution of childcare fees","Contribution of taxes","Contribution of other benefits","Total"],"default":0},{"id":"FREQ","name":"FREQ","ids":["A"],"names":["Annual"]}],"time_dim":"TIME_PERIOD","periods":["2001","2002","2003","2004","2005","2006","2007","2008","2009","2010","2011","2012","2013","2014","2015","2016","2017","2018","2019","2020","2021","2022","2023","2024","2025"],"statuses":["A"],"area_dim":"REF_AREA","n_series":255968,"n_obs":3408448,"n_rows_read":1792656,"layout":"parts","parts":{"SVK":{"file":"SVK.json.gz","n":6840,"bytes":36067},"ESP":{"file":"ESP.json.gz","n":6840,"bytes":39655},"GBR":{"file